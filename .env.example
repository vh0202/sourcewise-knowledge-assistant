# SourceWise configuration.
#
# Copy this file to `.env` (same folder) and change what you need. Every setting is optional:
# with no `.env` at all the app runs on http://127.0.0.1:8102 in extractive (offline) mode.
# Real environment variables take precedence over this file. Never commit `.env`.

# --- Answer engine ---------------------------------------------------------------------------
# With a key set, answers are written by Claude; without one, the deterministic extractive
# engine is used. Calls to the Claude API are billed to the key's owner.
# ANTHROPIC_API_KEY=

# auto = Claude when ANTHROPIC_API_KEY is set, otherwise offline. Force one with: offline | claude
SOURCEWISE_ENGINE=auto

# Claude model ID. Any current Claude model that supports citations can be used.
SOURCEWISE_CLAUDE_MODEL=claude-opus-5-5

# Upper bound on answer length (tokens) and how much reasoning the model spends on an answer:
# low | medium | high | xhigh | max, or "none" to leave the parameter out for models without it.
SOURCEWISE_CLAUDE_MAX_TOKENS=16000
SOURCEWISE_CLAUDE_EFFORT=medium

# Server-side refusal fallback (an Anthropic beta: if the model declines a request, Anthropic
# retries it on a fallback model). auto = on for the models that support it | on | off
SOURCEWISE_CLAUDE_REFUSAL_FALLBACK=auto

SOURCEWISE_CLAUDE_TIMEOUT_SECONDS=120

# If a Claude call fails (rate limit, network, invalid key), answer in extractive mode with a
# visible notice instead of showing an error.
SOURCEWISE_FALLBACK_TO_OFFLINE=true

# Pacing of the offline engine's streamed answer, in milliseconds per word (0 = instant).
SOURCEWISE_STREAM_DELAY_MS=12

# --- Retrieval -------------------------------------------------------------------------------
# auto = SQLite FTS5 when the SQLite build has it, otherwise the pure-Python BM25 index.
# Force one with: fts5 | bm25
SOURCEWISE_RETRIEVER=auto

# Passages retrieved per question.
SOURCEWISE_TOP_K=6

# Abstention gate: answer only if the best passage covers at least this share of the question's
# IDF-weighted terms, and at least this much evidence. Raise MIN_COVERAGE to decline more often.
SOURCEWISE_MIN_COVERAGE=0.55
SOURCEWISE_MIN_EVIDENCE=0.5

# Coverage threshold used instead of MIN_COVERAGE when the answer engine is Claude. Claude
# reads the passages and declines by itself when they do not answer the question, so the gate
# can let paraphrased questions through; MIN_EVIDENCE still applies. Set it to the value of
# MIN_COVERAGE to send Claude only what the extractive engine would be given (fewer API calls,
# more wrong refusals).
SOURCEWISE_CLAUDE_MIN_COVERAGE=0.25

# --- Ingestion -------------------------------------------------------------------------------
# Chunk size and overlap in characters (about 4 characters per token). Re-index documents after
# changing these.
SOURCEWISE_CHUNK_MAX_CHARS=700
SOURCEWISE_CHUNK_OVERLAP_CHARS=150
SOURCEWISE_MAX_UPLOAD_MB=10

# --- Server ----------------------------------------------------------------------------------
SOURCEWISE_HOST=127.0.0.1
SOURCEWISE_PORT=8102

# Where the SQLite database and uploaded files live (default: ./data).
# SOURCEWISE_DATA_DIR=./data

# Sign-in sessions last this long.
SOURCEWISE_SESSION_TTL_HOURS=168

# Set to true when the app is served over HTTPS so the session cookie is marked Secure.
SOURCEWISE_COOKIE_SECURE=false

# The login page lists the seeded demo accounts. Set to false for anything but a demo.
SOURCEWISE_SHOW_DEMO_ACCOUNTS=true
